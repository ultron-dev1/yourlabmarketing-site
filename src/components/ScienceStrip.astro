---
/**
 * A row of custom line-art science icons signalling who the studio serves.
 * Hand-drawn geometry in the same stroke weight as the well-plate mark, not
 * stock art, so it stays inside the site's own visual language. Each icon
 * draws itself in (stroke-dashoffset) the first time it scrolls into view.
 */
const items = [
  { label: "Microscopy", icon: "microscope" },
  { label: "Molecular biology", icon: "dna" },
  { label: "Wet lab", icon: "flask" },
  { label: "Sample prep", icon: "pipette" },
  { label: "Chemistry", icon: "molecule" },
];
---

<div class="science-strip">
  <div class="science-strip-inner">
    {
      items.map((item, i) => (
        <div class="science-item reveal" style={`--delay:${i * 70}ms`}>
          <svg
            class="science-icon"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {item.icon === "microscope" && (
              <>
                <circle cx="30" cy="8" r="3" />
                <line x1="29" y1="11" x2="18" y2="30" />
                <path d="M18,30 Q12,34 12,40" />
                <line x1="7" y1="32" x2="27" y2="32" />
                <circle cx="12" cy="37" r="1.6" />
                <rect x="9" y="41" width="14" height="3.5" rx="1.5" />
              </>
            )}
            {item.icon === "dna" && (
              <>
                <path d="M14,4 C14,9 34,9 34,14 C34,19 14,19 14,24 C14,29 34,29 34,34 C34,39 14,39 14,44" />
                <path d="M34,4 C34,9 14,9 14,14 C14,19 34,19 34,24 C34,29 14,29 14,34 C14,39 34,39 34,44" />
                <line x1="14" y1="4" x2="34" y2="4" />
                <line x1="14" y1="14" x2="34" y2="14" />
                <line x1="14" y1="24" x2="34" y2="24" />
                <line x1="14" y1="34" x2="34" y2="34" />
                <line x1="14" y1="44" x2="34" y2="44" />
              </>
            )}
            {item.icon === "flask" && (
              <>
                <line x1="20" y1="6" x2="20" y2="17" />
                <line x1="28" y1="6" x2="28" y2="17" />
                <line x1="19" y1="6" x2="29" y2="6" />
                <path d="M20,17 L9,39 Q8,43 12,43 L36,43 Q40,43 39,39 L28,17 Z" />
                <line x1="12.5" y1="34" x2="35.5" y2="34" />
                <circle cx="21" cy="27" r="1.1" />
                <circle cx="26" cy="24" r="1.1" />
              </>
            )}
            {item.icon === "pipette" && (
              <>
                <ellipse cx="24" cy="8" rx="6" ry="5" />
                <path d="M18.5,12 L16,40 L24,46 L32,40 L29.5,12 Z" />
                <line x1="18" y1="18" x2="30" y2="18" />
                <line x1="18.5" y1="25" x2="29.5" y2="25" />
                <line x1="19" y1="32" x2="29" y2="32" />
              </>
            )}
            {item.icon === "molecule" && (
              <>
                <line x1="24" y1="24" x2="24" y2="8" />
                <line x1="24" y1="24" x2="38" y2="32" />
                <line x1="24" y1="24" x2="10" y2="32" />
                <circle cx="24" cy="24" r="5" />
                <circle cx="24" cy="8" r="3.2" />
                <circle cx="38" cy="32" r="3.2" />
                <circle cx="10" cy="32" r="3.2" />
              </>
            )}
          </svg>
          <span class="science-label">{item.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .science-strip {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .science-strip-inner {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(1.75rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 3vw, 2rem);
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .science-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
  }

  .science-icon {
    width: 30px;
    height: 30px;
    color: var(--muted-2);
    transition: color 0.25s;
  }

  .science-item:hover .science-icon {
    color: var(--accent);
  }

  .science-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Draw-on-scroll: every stroke starts fully hidden and traces itself in. */
  .science-icon :global(circle),
  .science-icon :global(line),
  .science-icon :global(path),
  .science-icon :global(ellipse),
  .science-icon :global(rect) {
    stroke-dasharray: 140;
    stroke-dashoffset: 140;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: inherit;
  }

  .science-item.is-in .science-icon :global(circle),
  .science-item.is-in .science-icon :global(line),
  .science-item.is-in .science-icon :global(path),
  .science-item.is-in .science-icon :global(ellipse),
  .science-item.is-in .science-icon :global(rect) {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .science-icon :global(circle),
    .science-icon :global(line),
    .science-icon :global(path),
    .science-icon :global(ellipse),
    .science-icon :global(rect) {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
