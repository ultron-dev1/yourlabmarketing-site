---
import Base from "../layouts/Base.astro";
import Plate from "../components/Plate.astro";
import Showcase from "../components/Showcase.astro";
import ScienceStrip from "../components/ScienceStrip.astro";
import AudienceGallery from "../components/AudienceGallery.astro";

const PORTAL_URL = "https://your-lab-marketing-portal.vercel.app";
const EMAIL = "hello@yourlabmarketing.com";

const pillars = [
  {
    n: "01",
    title: "Social media management",
    body: "We read the manuscript, the methods and the limitations, not just the abstract, and write posts that hold up if a reviewer reads them. Written per platform, not one caption pasted three times.",
    list: ["LinkedIn", "X", "Instagram"],
    href: "/services#social",
  },
  {
    n: "02",
    title: "Website design and updates",
    body: "A full redesign when the site is slow or dated, or ongoing updates so it stops looking like it was last touched two grant cycles ago. You approve the direction before anything gets built.",
    list: ["Redesign", "Ongoing updates"],
    href: "/services#web",
  },
];

const steps = [
  {
    n: "01",
    title: "Send us the work",
    body: "A paper, a preprint, figures, or a note about what happened this week. There is no intake form to fight.",
  },
  {
    n: "02",
    title: "We draft",
    body: "AI drafts from your source material for each platform you're on. A person on our team checks the science and the voice before you ever see it.",
  },
  {
    n: "03",
    title: "You approve",
    body: "One screen shows every draft as it will appear on the feed. Approve it, or ask for a change in a sentence.",
  },
  {
    n: "04",
    title: "It goes out",
    body: "Approved posts get published on schedule, and you get a digest of what went live and how it did.",
  },
];

const pains = [
  "A paper lands, gets one tweet from a co-author, and disappears.",
  "The lab website was last updated two grant cycles ago.",
  "Whoever has time writes the posts, so the voice changes every month.",
  "Prospective students and collaborators can't tell what you're working on now.",
  "Funders and press ask for 'broader impact' and there's nothing to point at.",
];
---

<Base
  title="Your Lab Marketing | Marketing for research labs"
  description="AI-drafted, human-reviewed marketing for research labs: social media across LinkedIn, X, and Instagram, plus website design and updates."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow reveal">Marketing for scientific ambition</span>
        <h1 class="reveal" style="--delay:60ms">
          Make your lab <em>impossible</em> to overlook.
        </h1>
        <p class="lede measure reveal" style="--delay:140ms">
          We turn your papers into posts and keep your site current, so
          funders, collaborators, and prospective students see a lab worth
          paying attention to.
        </p>
        <div class="hero-cta reveal" style="--delay:220ms">
          <a class="btn btn-primary" href={`mailto:${EMAIL}`}>
            Start a conversation
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#work">See the work</a>
        </div>
        <ul class="hero-notes">
          <li class="reveal" style="--delay:300ms">AI drafts fast, a person reviews every line</li>
          <li class="reveal" style="--delay:370ms">You approve everything before it goes out, too</li>
        </ul>
      </div>

      <div class="hero-visual reveal" style="--delay:180ms">
        <Plate />
      </div>
    </div>
  </section>

  <ScienceStrip />

  <!-- ================= WHY ================= -->
  <section class="section why" id="why">
    <div class="wrap why-grid">
      <div class="why-copy reveal">
        <span class="eyebrow">The gap</span>
        <h2>Good science is not self-publicising.</h2>
        <p class="lede measure-sm">
          Nobody in a lab was hired to run a content calendar. The work is
          interesting. Writing about it well is a separate job, and it keeps
          losing to the actual job.
        </p>
      </div>

      <ul class="pains">
        {
          pains.map((p, i) => (
            <li class="reveal" style={`--delay:${i * 70}ms`}>
              <span class="pain-well" aria-hidden="true" />
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section services" id="services">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">What we do</span>
        <h2>Two services, one studio.</h2>
        <p class="lede measure">
          We work the way a good collaborator does: read the material, ask when
          something is ambiguous, and never oversell a result you'd have to walk
          back.
        </p>
      </div>

      <div class="pillar-grid">
        {
          pillars.map((p, i) => (
            <a class="pillar-tile card reveal" style={`--delay:${i * 100}ms`} href={p.href}>
              <span class="pillar-n">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <ul class="pillar-list">
                {p.list.map((item) => <li>{item}</li>)}
              </ul>
              <span class="pillar-link">
                See this service
                <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= SHOWCASE ================= -->
  <Showcase />

  <!-- ================= PROCESS ================= -->
  <section class="section process" id="process">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Four steps, and three of them are ours.</h2>
      </div>

      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step reveal" style={`--delay:${i * 90}ms`}>
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= PORTAL ================= -->
  <section class="section portal" id="portal">
    <div class="wrap portal-grid">
      <div class="portal-copy reveal">
        <span class="eyebrow">The portal</span>
        <h2>Your approval queue, not your inbox.</h2>
        <p class="lede measure-sm">
          Every client gets a private workspace branded to their own lab. Drafts
          appear as they will look on the feed, you approve or ask for a change,
          and the studio picks it up from there.
        </p>
        <ul class="portal-list">
          <li class="reveal" style="--delay:0ms">Posts shown as real platform previews, not rows in a table</li>
          <li class="reveal" style="--delay:60ms">Approve, or ask for a change in one sentence</li>
          <li class="reveal" style="--delay:120ms">Request a post, or upload an image, whenever it occurs to you</li>
          <li class="reveal" style="--delay:180ms">Only your lab can see it</li>
        </ul>
        <a class="link-arrow" href={PORTAL_URL} rel="noopener">
          Visit the client portal
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="portal-mock reveal" style="--delay:120ms" aria-hidden="true">
        <div class="mock">
          <div class="mock-bar">
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <span class="mock-dot"></span>
            <span class="mock-title">Aster Lab · Approvals</span>
          </div>
          <div class="mock-body">
            <div class="mock-row is-pending">
              <span class="mock-status">
                <span class="mock-pulse"></span>Needs approval
              </span>
              <p>Sleep fragmentation paper · LinkedIn</p>
              <div class="mock-actions">
                <span class="mock-btn mock-btn-go">Approve</span>
                <span class="mock-btn">Ask for changes</span>
              </div>
            </div>
            <div class="mock-row">
              <span class="mock-status is-ok">Approved</span>
              <p>Ripple-density figure · Instagram</p>
            </div>
            <div class="mock-row">
              <span class="mock-status is-sched">Scheduled</span>
              <p>Conference talk announcement · X</p>
            </div>
            <div class="mock-row">
              <span class="mock-status is-ok">Approved</span>
              <p>PhD position open · LinkedIn</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AudienceGallery />

  <!-- ================= CTA ================= -->
  <section class="section cta on-navy" id="contact">
    <div class="wrap cta-inner">
      <div class="reveal">
        <span class="eyebrow">Ready when you are</span>
        <h2>Your next discovery deserves an audience.</h2>
        <p class="lede measure">
          Tell us what your lab is working on. We'll say plainly what
          consistent posts and a site that keeps up would look like, and
          what it would cost.
        </p>
      </div>
      <div class="cta-actions reveal" style="--delay:100ms">
        <a class="btn btn-primary" href={`mailto:${EMAIL}`}>
          Start a conversation
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href={PORTAL_URL} rel="noopener">
          Client login
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ================= HERO ================= */

  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 7rem);
  }

  /* faint well-plate lattice behind the hero */
  .hero-grid {
    position: absolute;
    inset: -10% -5% auto;
    height: 130%;
    background-image: radial-gradient(
      circle at center,
      rgba(12, 30, 51, 0.09) 1.4px,
      transparent 1.5px
    );
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(
      ellipse 75% 60% at 60% 35%,
      #000 20%,
      transparent 75%
    );
    mask-image: radial-gradient(
      ellipse 75% 60% at 60% 35%,
      #000 20%,
      transparent 75%
    );
    pointer-events: none;
    will-change: transform;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-copy h1 {
    margin-bottom: 1.5rem;
  }

  .hero-copy h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .hero-notes li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-notes li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* ================= WHY ================= */

  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .why-copy h2 {
    margin-bottom: 1.25rem;
  }

  .pains li {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 1.0625rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .pains li:first-child {
    padding-top: 0;
  }

  .pains li:last-child {
    border-bottom: 0;
  }

  .pain-well {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--muted-2);
    transform: translateY(1px);
  }

  /* ================= section heads ================= */

  .sec-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sec-head h2 {
    margin-bottom: 1.25rem;
  }

  /* ================= SERVICES ================= */

  .services {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 1.25rem;
  }

  .pillar-tile {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s,
      border-color 0.3s;
  }

  .pillar-tile:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--accent-line);
  }

  .pillar-n {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .pillar-tile h3 {
    margin-bottom: 0.75rem;
  }

  .pillar-tile p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .pillar-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
  }

  .pillar-list li {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    background: var(--accent-tint);
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    padding: 0.3125rem 0.75rem;
  }

  .pillar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  .pillar-link .arrow {
    transition: transform 0.2s;
  }

  .pillar-tile:hover .pillar-link .arrow {
    transform: translateX(3px);
  }

  /* ================= PROCESS ================= */

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    /* Columns are separated by each step's own right padding; the row gap
       only matters once the steps wrap, where the next step's rule would
       otherwise land on top of the previous step's text. */
    gap: 2.5rem 0;
  }

  .step {
    position: relative;
    padding: 2rem 1.5rem 0 0;
    border-top: 1px solid var(--ink);
  }

  /* the marker sitting on the rule */
  .step::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .step-n {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted-2);
    margin-bottom: 1rem;
  }

  .step h3 {
    margin-bottom: 0.625rem;
  }

  .step p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
    max-width: 34ch;
  }

  /* ================= PORTAL ================= */

  .portal {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }

  .portal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  .portal-copy h2 {
    margin-bottom: 1.25rem;
  }

  .portal-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 2rem 0;
  }

  .portal-list li {
    position: relative;
    padding-left: 1.75rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .portal-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 10px;
    height: 6px;
    border-left: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: rotate(-45deg);
  }

  /* ---- portal mock ---- */

  .mock {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .mock-bar {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.75rem 1rem;
    background: var(--navy);
    border-bottom: 1px solid var(--navy-line);
  }

  .mock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--navy-line);
  }

  .mock-title {
    margin-left: 0.625rem;
    font-size: 0.75rem;
    color: var(--navy-ink);
  }

  .mock-row {
    display: grid;
    gap: 0.625rem;
    padding: 1.0625rem 1.25rem;
    border-bottom: 1px solid var(--line-2);
  }

  .mock-row:last-child {
    border-bottom: 0;
  }

  .mock-row.is-pending {
    background: var(--accent-tint);
  }

  .mock-row p {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .mock-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    justify-self: start;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .mock-status.is-ok {
    color: #1f6b43;
  }

  .mock-status.is-sched {
    color: #2a5698;
  }

  .mock-status.is-ok::before,
  .mock-status.is-sched::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .mock-pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .mock-pulse::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    opacity: 0;
    animation: ping 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .mock-actions {
    display: flex;
    gap: 0.5rem;
  }

  .mock-btn {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--accent-line);
    color: var(--accent-ink);
    background: var(--surface);
  }

  .mock-btn-go {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* ================= CTA ================= */

  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .cta-inner h2 {
    margin-bottom: 1.25rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  /* ================= responsive ================= */

  @media (max-width: 980px) {
    .hero-inner,
    .why-grid,
    .portal-grid,
    .cta-inner {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      order: -1;
      max-width: 560px;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 620px) {
    .step {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-tile:hover {
      transform: none;
    }

    .mock-pulse::after {
      animation: none;
    }
  }
</style>

<script>
  // A faint drift on the hero's dot lattice while it's on screen, capped
  // small so it reads as depth, not distraction.
  const grid = document.querySelector<HTMLElement>(".hero-grid");
  const hero = document.querySelector<HTMLElement>(".hero");
  if (grid && hero && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    let active = false;

    const update = () => {
      ticking = false;
      if (!active) return;
      const rect = hero.getBoundingClientRect();
      const drift = Math.max(-16, Math.min(16, rect.top * -0.06));
      grid.style.transform = `translateY(${drift}px)`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        active = entry.isIntersecting;
        if (active) onScroll();
      },
      { threshold: 0 },
    );
    io.observe(hero);
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
