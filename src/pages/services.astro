---
import Base from "../layouts/Base.astro";

const platforms = [
  {
    name: "LinkedIn",
    note: "Where PIs, collaborators, and funders look you up",
    body: "Considered, paragraph-length posts: new papers, grants, hires, and the occasional opinion on where the field is headed. This is the platform that gets read by people deciding whether to collaborate with you.",
  },
  {
    name: "X",
    note: "Fast, in the room while it's happening",
    body: "Threads that break a new result into a readable sequence, quick takes on other labs' work, conference live-notes. X moves fast, and posting close to the moment is most of the job.",
  },
  {
    name: "Instagram",
    note: "The visual side of the lab",
    body: "Figures worth a second look, lab life, defences, new equipment. Instagram is where the work gets a face, so the account reads like a lab people would want to join.",
  },
];

const included = [
  "AI drafts from your source material, a person on our team edits every post",
  "Posts written for each platform's register, LinkedIn to X to Instagram",
  "Every draft approved by your lab in the client portal before it goes out",
  "One voice across accounts, even as who's writing changes",
  "A monthly digest of what went out and how it did",
];

const webWork = [
  {
    title: "Redesign",
    body: "A full rebuild when the current site is slow, dated, or doesn't say what the lab actually does. Same content structure you already have, or a new one if it's not working. You approve the direction before anything gets built.",
  },
  {
    title: "Updates",
    body: "New pages, a refreshed publications list, updated team photos, a new grant announcement. None of that needs a full rebuild. It needs someone touching the site regularly instead of leaving it alone for two grant cycles.",
  },
];

const webSteps = [
  { label: "Audit", body: "We look at the current site and say plainly what's working and what isn't." },
  { label: "Direction", body: "A proposed structure and look, before any real building starts." },
  { label: "Build", body: "The site gets built. You see progress, not just a final reveal." },
  { label: "Launch", body: "It goes live on your domain, and you get shown how to ask for changes later." },
];

const PORTAL_URL = "https://your-lab-marketing-portal.vercel.app";
const EMAIL = "hello@yourlabmarketing.com";
---

<Base
  title="Services | Your Lab Marketing"
  description="Two services for research labs: social media management across LinkedIn, X, and Instagram, and website design, redesigns, and ongoing updates."
>
  <!-- ================= HERO ================= -->
  <section class="section services-hero">
    <div class="wrap services-hero-inner">
      <div class="services-hero-copy reveal">
        <h1>Social media and websites, built for labs.</h1>
        <p class="lede measure">
          Two services under one studio, so your feed and your site finally
          sound like the same lab. Start with one, or run both together.
        </p>
        <div class="services-hero-cta">
          <a class="btn btn-primary" href={`mailto:${EMAIL}`}>
            Start a conversation
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#social">See what's included</a>
        </div>
      </div>

      <div class="services-hero-visual reveal" style="--delay:150ms">
        <img
          src="/images/researcher.jpg"
          alt="A researcher in a cleanroom suit operating lab instrumentation"
          width="1600"
          height="1067"
        />
      </div>
    </div>
  </section>

  <!-- ================= SOCIAL ================= -->
  <section class="section pillar" id="social">
    <div class="wrap">
      <div class="pillar-head reveal">
        <h2>Social media management</h2>
        <p class="lede measure-sm">
          We read the paper, write the post, and hand you the approve button.
          Three platforms, three different jobs, one consistent voice.
        </p>
      </div>

      <div class="platform-grid">
        {
          platforms.map((p, i) => (
            <article class="platform card reveal" style={`--delay:${i * 80}ms`}>
              <span class="platform-badge">{p.name}</span>
              <h3>{p.note}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>

      <ul class="included">
        {
          included.map((line, i) => (
            <li class="reveal" style={`--delay:${i * 60}ms`}>{line}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= WEB ================= -->
  <section class="section pillar pillar-alt" id="web">
    <div class="wrap">
      <div class="pillar-head reveal">
        <h2>Website design and updates</h2>
        <p class="lede measure-sm">
          A site is the one thing a prospective student, funder, or
          collaborator checks before anything else. Most lab sites were built
          once and never touched again.
        </p>
      </div>

      <div class="web-grid">
        {
          webWork.map((w, i) => (
            <article class="web-card card reveal" style={`--delay:${i * 90}ms`}>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </article>
          ))
        }
      </div>

      <div class="web-steps-wrap reveal" style="--delay:180ms">
        <h3 class="web-steps-title">A redesign, in four steps</h3>
        <ol class="web-steps">
          {
            webSteps.map((s) => (
              <li>
                <span class="web-step-label">{s.label}</span>
                <span class="web-step-body">{s.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="section services-cta on-navy">
    <div class="wrap services-cta-inner">
      <div class="reveal">
        <h2>Not sure which one you need?</h2>
        <p class="lede measure">
          Most labs start with one service and add the other later. Tell us
          where things stand and we'll say plainly where to start.
        </p>
      </div>
      <div class="services-cta-actions reveal" style="--delay:100ms">
        <a class="btn btn-primary" href={`mailto:${EMAIL}`}>
          Start a conversation
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href={PORTAL_URL} rel="noopener">
          Client login
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ================= HERO ================= */

  .services-hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 7rem);
  }

  .services-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .services-hero-copy h1 {
    max-width: 18ch;
    margin-block: 0 1.5rem;
  }

  .services-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .services-hero-visual {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    outline: 1px solid rgba(12, 30, 51, 0.08);
    outline-offset: -1px;
    aspect-ratio: 4 / 5;
  }

  .services-hero-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .services-hero-inner {
      grid-template-columns: 1fr;
    }

    .services-hero-visual {
      order: -1;
      aspect-ratio: 16 / 10;
      max-width: 560px;
    }
  }

  /* ================= PILLAR (shared) ================= */

  .pillar {
    border-top: 1px solid var(--line);
  }

  .pillar-alt {
    background: var(--surface-2);
  }

  .pillar-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .pillar-head h2 {
    margin-bottom: 1.25rem;
  }

  /* ---------- platform cards ---------- */

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .platform {
    padding: 1.75rem 1.5rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s,
      border-color 0.3s;
  }

  .platform:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--accent-line);
  }

  .platform-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent-tint);
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    padding: 0.3125rem 0.75rem;
    margin-bottom: 1.25rem;
  }

  .platform h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.75rem;
  }

  .platform p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  /* ---------- included list ---------- */

  .included {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 0.75rem 2rem;
    max-width: 56rem;
  }

  .included li {
    position: relative;
    padding-left: 1.75rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .included li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 10px;
    height: 6px;
    border-left: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: rotate(-45deg);
  }

  /* ---------- web cards ---------- */

  .web-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .web-card {
    padding: 1.75rem 1.5rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s,
      border-color 0.3s;
  }

  .web-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--accent-line);
  }

  .web-card h3 {
    margin-bottom: 0.75rem;
  }

  .web-card p {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  /* ---------- web steps ---------- */

  .web-steps-title {
    font-size: 1.0625rem;
    margin-bottom: 1.5rem;
  }

  .web-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 1.5rem;
    counter-reset: none;
  }

  .web-steps li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .web-step-label {
    font-family: var(--serif);
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .web-step-body {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  /* ================= CTA ================= */

  .services-cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .services-cta-inner h2 {
    margin-bottom: 1.25rem;
  }

  .services-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  /* ================= responsive ================= */

  @media (max-width: 900px) {
    .services-cta-inner {
      grid-template-columns: 1fr;
    }

    .services-cta-actions {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .platform:hover,
    .web-card:hover {
      transform: none;
    }
  }
</style>
